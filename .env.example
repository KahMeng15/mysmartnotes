# Database Configuration
# These are used to construct the PostgreSQL connection string
DB_USER=your-db-user
# Generate a secure password: openssl rand -base64 24
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your-db-name

# Runtime Environment
ENVIRONMENT=development

# JWT Security
# Generate a secure secret key with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# Browser Security / Session
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Encryption for sensitive fields stored in database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Task retention
TASK_RETENTION_DAYS=14

# ============================================
# Admin Bootstrap Account
# ============================================
# If set, this account will automatically be elevated to Admin on startup if it exists
ADMIN_EMAIL=admin@example.com

# ============================================
# Global AI Configuration (3-Tier Fallback)
# ============================================
# Tier 1 (Primary - Gemini)
GLOBAL_AI_TIER1_PROVIDER=gemini
GLOBAL_AI_TIER1_MODEL=models/gemma-4-31b-it
GLOBAL_AI_TIER1_API_KEY=
GLOBAL_AI_TIER1_REASONING_LEVEL=high

# Tier 2 (Secondary - Gemini)
GLOBAL_AI_TIER2_PROVIDER=gemini
GLOBAL_AI_TIER2_MODEL=models/gemma-4-26b-a4b-it
GLOBAL_AI_TIER2_API_KEY=
GLOBAL_AI_TIER2_REASONING_LEVEL=high

# Tier 3 (Local Fallback - Ollama)
GLOBAL_AI_TIER3_PROVIDER=ollama
GLOBAL_AI_TIER3_MODEL=llama3
GLOBAL_AI_TIER3_API_KEY=
GLOBAL_AI_TIER3_REASONING_LEVEL=low
GLOBAL_AI_TIER3_BASE_URL=http://localhost:11434

# ============================================
# FALLBACK SETTINGS (Legacy/Individual Override)
# ============================================
GEMINI_API_KEY=your-gemini-api-key-here
HUGGINGFACE_TOKEN=your-huggingface-token-here
AI_PROVIDER=
OLLAMA_BASE_URL=

# ============================================
# Application Settings
# ============================================
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# File Upload Limits
MAX_UPLOAD_SIZE_MB=50

# ============================================
# Firebase Configuration
# ============================================
# Get these values from your Firebase Console (Project Settings)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
