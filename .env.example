# Python Path
PYTHONPATH=/app

# Database
DATABASE_URL=sqlite:///./data/app.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Runtime Environment
ENVIRONMENT=development
ALLOW_SQLITE_IN_PRODUCTION=false

# JWT Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser Security / Session
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Encryption for sensitive fields stored in database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Task retention
TASK_RETENTION_DAYS=14

# ============================================
# AI Configuration
# ============================================
# GLOBAL SETTINGS (Administrator-managed)
# These are the default AI settings available to all users
# Users can choose to use these OR configure their own personal settings
# ============================================
GLOBAL_AI_PROVIDER=gemini
GLOBAL_GEMINI_API_KEY=your-global-gemini-api-key
GLOBAL_AI_MODEL=models/gemma-3-27b-it
GLOBAL_HUGGINGFACE_TOKEN=your-global-huggingface-token


# ============================================
# FALLBACK SETTINGS (Used when user has no personal settings and not using global)
# These are system-wide fallbacks - typically not used in production
# ============================================
GEMINI_API_KEY=your-gemini-api-key-here
HUGGINGFACE_TOKEN=your-huggingface-token-here
AI_PROVIDER=
OLLAMA_BASE_URL=

# ============================================
# Application Settings
# ============================================
APP_NAME=MySmartNotes
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# File Upload Limits
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,pptx,png,jpg,jpeg

# Processing
OCR_ENABLED=True
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================
# Firebase Configuration
# ============================================
# Get these values from your Firebase Console (Project Settings)
# https://console.firebase.google.com/
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=mysmartnotes-965fe.firebaseapp.com
FIREBASE_PROJECT_ID=mysmartnotes-965fe
FIREBASE_STORAGE_BUCKET=mysmartnotes-965fe.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id