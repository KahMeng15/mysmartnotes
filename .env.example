# Database Configuration
# These are used to construct the PostgreSQL connection string
DB_USER=your-db-user
# Generate a secure password: openssl rand -base64 24
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your-db-name

# Runtime Environment
ENVIRONMENT=development

# JWT Security
# Generate a secure secret key with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# Browser Security / Session
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Encryption for sensitive fields stored in database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Task retention
TASK_RETENTION_DAYS=14

# ============================================
# Admin Bootstrap Account
# ============================================
# If set, this account will automatically be elevated to Admin on startup if it exists
ADMIN_EMAIL=admin@example.com

# ============================================
# AI Configuration
# ============================================
# GLOBAL SETTINGS (Administrator-managed)
GLOBAL_AI_PROVIDER=gemini
GLOBAL_GEMINI_API_KEY=your-global-gemini-api-key
GLOBAL_AI_MODEL=gemini-1.5-flash
GLOBAL_REASONING_LEVEL=medium
GLOBAL_HUGGINGFACE_TOKEN=your-global-huggingface-token


# ============================================
# FALLBACK SETTINGS (Typically not used in production)
# ============================================
GEMINI_API_KEY=your-gemini-api-key-here
HUGGINGFACE_TOKEN=your-huggingface-token-here
AI_PROVIDER=
OLLAMA_BASE_URL=

# ============================================
# Application Settings
# ============================================
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# File Upload Limits
MAX_UPLOAD_SIZE_MB=50

# ============================================
# Firebase Configuration
# ============================================
# Get these values from your Firebase Console (Project Settings)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
